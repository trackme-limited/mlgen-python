# =============================================================================
# ML Gen — Environment Configuration
# =============================================================================
# Copy this file to .env and edit as needed:
#   cp .env.example .env
# =============================================================================

# --- Splunk HEC Connection ---
SPLUNK_HEC_URL=https://your-splunk:8088
SPLUNK_HEC_TOKEN=your-hec-token-here
SPLUNK_INDEX=mlgen
SPLUNK_SOURCETYPE=_json
SSL_VERIFY=false

# --- Backfill ---
# On startup, the generator automatically backfills historical data for all
# entities (using normal behavior) to build a clean ML training baseline.
# After backfill completes, it transitions to continuous generation where
# each entity follows its assigned behavior (normal / lower / upper outlier).
BACKFILL_DAYS=90

# Interval in seconds between data points during backfill
BACKFILL_INTERVAL=60

# --- Entity Configuration ---
#
# Seasonal entities follow day-of-week and hour-of-day patterns
# (e.g. security logs, web traffic — higher during business hours)
NUM_NORMAL=5
NUM_LOWER_OUTLIER=1
NUM_UPPER_OUTLIER=1

# Flat entities have NO seasonality — steady, near-constant volumes
# (e.g. IT ops metrics collection, SNMP, performance monitoring)
NUM_FLAT_NORMAL=1
NUM_FLAT_LOWER_OUTLIER=1

# Behavior-change entities simulate progressive data onboarding:
# Volume ramps up over ~60 days, then shifts to a higher baseline for the
# last ~30 days. Useful for demoing ML model retraining / adaptation.
NUM_BEHAVIOR_CHANGE=1

# Variation percentage for outlier entities (applied as +/- to baseline)
VARIATION_PCT=75

# Anomaly cycling: outlier entities automatically alternate between anomaly
# and normal phases to simulate realistic incident lifecycles.
# Comma-separated list of possible durations in hours (one is picked randomly).
ANOMALY_DURATIONS=12,24,48
NORMAL_DURATIONS=48,72,96,168

# Entity names are picked from a built-in catalog of realistic Splunk data sources
# (e.g. security:linux_secure, cloud:aws:cloudtrail, network:pan:traffic).
# If you need more entities than the catalog has (20), extras use this prefix.
ENTITY_PREFIX=custom

# --- Generation Settings ---
# Interval in seconds between data points in continuous mode
GENERATION_INTERVAL=60

# HEC batch size (events are batched before sending)
HEC_BATCH_SIZE=1000

# Seasonality mode: curve (sine wave peaking at noon) or stdev (Gaussian peaking at 18h)
SEASONALITY_MODE=curve

# --- Instance & Control ---

# Instance ID: if set, this fixed value is used as instance_id for all events.
# If empty (default), a new UUID is generated each time the container starts.
# Useful when you want to keep the same instance_id across restarts.
INSTANCE_ID=

# Disable all anomalies: set to 1 to force ALL entities (including outliers
# and short-cycle) to normal behavior. No anomaly cycles will run.
# Useful for generating a clean baseline without any outliers.
# 0 = normal behavior (default), 1 = all anomalies disabled.
DISABLE_ALL_ANOMALIES=0

# Keep anomalies for specific entities: comma-separated list of entity refs
# that will KEEP generating anomalies even when DISABLE_ALL_ANOMALIES=1.
# This lets you produce a clean baseline for most entities while keeping a
# few entities cycling anomalies (e.g. for a focused ML demo).
# Only takes effect when DISABLE_ALL_ANOMALIES=1. Empty (default) = no exceptions.
# Refs not present in the generated entity set are ignored (logged as a warning).
# Available refs:
#   applog:docker:container:json
#   cloud:aws:cloudtrail
#   cloud:gcp:pubsub:audit
#   cloud:mscs:azure:eventhub
#   database:oracle:audit
#   endpoint:XmlWinEventLog:Microsoft-Windows-Sysmon/Operational
#   infra:syslog
#   infra:vmware:esxlog:hostd
#   itops:perfmon:metrics
#   itops:snmp:traps
#   proxy:zscalernss-web
#   web:access_combined
#   wineventlog:WinEventLog:System
# Example: KEEP_ANOMALIES_ENTITIES=cloud:aws:cloudtrail,web:access_combined
KEEP_ANOMALIES_ENTITIES=

# --- Full versus Incremental ML Qualification ---
#
# Opt-in deterministic A/B scenario for qualifying TrackMe incremental model
# training. It adds two flat entities whose metric values are exactly equal:
#   qualification:recurring-regime:full
#   qualification:recurring-regime:incremental
#
# Configure the first entity's TrackMe model as full and the second as
# incremental. Both see regime A, then regime B for longer than the model
# calculation window, then regime A returns. See README.md for the runbook.
#
# Empty/off (default) = no qualification entities
# incremental_ab = enable the paired recurring-regime scenario
QUALIFICATION_PROFILE=

# Stable seed used to produce the shared value for both entities at each time.
QUALIFICATION_SEED=42

# This must match the TrackMe model's calculation window in minutes.
QUALIFICATION_WINDOW_MINUTES=30

# Scenario timeline: A warmup -> B -> A return. The B duration must be greater
# than QUALIFICATION_WINDOW_MINUTES so full training can forget regime A.
QUALIFICATION_WARMUP_MINUTES=10
QUALIFICATION_NEW_REGIME_MINUTES=40
QUALIFICATION_RETURN_MINUTES=15

# Relative levels and natural noise for both paired entities.
QUALIFICATION_REGIME_A_PCT=100
QUALIFICATION_REGIME_B_PCT=140
QUALIFICATION_NOISE_PCT=2

# Optional ISO-8601 start time, for example 2026-07-30T12:00:00Z.
# Leave empty on a fresh run: the scenario begins after backfill completes.
# Pin this together with INSTANCE_ID if a container recreation must continue
# the same timeline rather than restart it.
QUALIFICATION_START_TIME=

# --- Logging & Debug ---
LOG_LEVEL=INFO
DRY_RUN=false
